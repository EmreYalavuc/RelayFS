{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayFS",
  "version": "0.1.1",
  "identifier": "dev.relayfs.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RelayFS",
        "width": 440,
        "height": 800,
        "minWidth": 400,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RelayFS",
    "copyright": "Copyright © 2026 RelayFS",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
